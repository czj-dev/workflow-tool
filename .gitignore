# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 构建产物
/build/
/build/bin/
/workflow-tool
/WorkflowTool.app/
# 随产物携带的工具二进制（bin/jq 等：构建机复制进 bin/，shell 运行环境注入 PATH）
/bin/

# Node / 前端
node_modules/
frontend/dist/
frontend/bindings/
frontend/package-lock.json

# Wails 生成
/wails/

# IDE
.idea/
.vscode/
*.swp

# 设计稿（本地 mockup，不入仓库）
.design/

# Claude Code / Codex（本地 skill / 工具配置，不入仓库）
.claude/
.agents/
.codex/
skills-lock.json

# 工具缓存
.cache/
__pycache__/
.playwright-cli/

# OS
.DS_Store
Thumbs.db

# skill 同步足迹（运行时生成，不入仓库）
skills.synced.json

# 运行记录与应用日志（运行时生成，exe 同级，不入仓库）
runs/
logs/

# 调度器的「上次评估时刻」（运行时生成，exe 同级，不入仓库）
schedules.state.json

# pi 运行时目录（hermetic agent/会话，运行时生成，exe 同级，不入仓库）
pi-agent/
pi-sessions/

# 随包分发的 pi 二进制探测位（<BaseDir>/pi/pi，本地自备；AI_PI_BIN 显式指定时不适用）。
# 目录本身不能整目录忽略（否则 ! 例外进不去），改为忽略内容；仅版本标注文件入库
/pi/*
!/pi/version.yaml

# 业务 skill 本体（含敏感数据，各端自备；yaml 引用保留，缺技能时对应动作加载失败）
skills/icafe-bug-analyzer/
skills/icafe-skill/
